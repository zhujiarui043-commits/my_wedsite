{
  "name": "jerry-journal-local",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/prepare-image-previews.cjs && next build --webpack && node scripts/prepare-standalone.cjs",
    "start": "node scripts/start-website.cjs",
    "share": "npm run build && node scripts/share-preview.cjs",
    "test:share": "node --test tests/share-preview.test.cjs",
    "test:sphere": "node --experimental-strip-types --test tests/photo-sphere.test.cjs",
    "gallery:prepare": "node scripts/prepare-gallery.cjs",
    "gallery:previews": "node scripts/prepare-image-previews.cjs",
    "test:images": "node --test tests/image-previews.test.cjs",
    "test:likes": "node --test tests/gallery-likes.test.cjs",
    "test:guestbook": "node --test tests/guestbook.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:website": "node --test tests/website.test.cjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.8",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
